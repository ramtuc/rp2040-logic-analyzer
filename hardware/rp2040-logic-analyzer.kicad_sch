	(text "SW1 (SK13D07VG5) is a SHORTING slide switch: +3V3 (pin 2) and +5V (pin 4) are never adjacent; EXT (pin 3) sits between. Do not slide with EXT connected."
		(exclude_from_sim no)
		(at 12.7 257.81 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0ca0d7e9-f446-51d1-9c96-f8cda6aadd44")
	)
	(text "USB path: J1 -> U8 (USBLC6) -> R19/R20 27R -> RP2040. No external pull-ups (RP2040 internal). CC1/CC2: 5.1k each to GND."
		(exclude_from_sim no)
		(at 12.7 261.62 0)
		(effects
			(font
				(size 1.5 1.5)
