	(text "U1 RP2040 + U2 W25Q128 (QSPI) + X1 12MHz ; 100nF x10 (C1-C10) + 1uF x2 (C21/C22) ; BOOT = SW2, RUN = SW3"
		(exclude_from_sim no)
		(at 142.24 19.05 0)
