		(uuid "095e7621-d54d-598b-8d4f-1b6ff1fa128a")
	)
	(text "Crystal: 1k damping on the XOUT side (R21), XIN direct. 15pF x2 at the crystal pins. RP2040 TESTEN tied to GND (datasheet)."
