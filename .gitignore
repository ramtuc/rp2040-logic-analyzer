# 除外
build/
*.tmp
~*

# LCSC / EasyEDA 由来のライブラリは公開リポジトリに同梱しない（ライセンス未確認）
# README の easyeda2kicad コマンドで各自が生成する
lib/lcsc/
lib/logicana.pretty/
lib/logicana.3dshapes/

# KiCad が勝手に作るもの・kicad-cli の中間出力（hardware/out の PDF・CSV・md は残す）
*.kicad_prl
*.lck
*-backups/
_autosave-*
fp-info-cache
hardware/out/*.net
hardware/out/*.xml
hardware/out/erc.json
hardware/out/svg/
__pycache__/
*.pyc
# freerouting の中間ファイル
hardware/out/route/*.dsn
hardware/out/route/*.ses
# 第3工程の試行物（最良版 03-final-* と md/png/rpt だけ残す）
build/
hardware/out/step3/route-*/
hardware/out/step3/01*.kicad_*
hardware/out/step3/02-*
hardware/out/step3/*-cleaned.kicad_pcb
hardware/out/step3/drc-0[012]*.json
hardware/out/step3/*.kicad_prl
# 人間の配線完了作業の試行物（RESULT.md・md・png・スクリプトだけ残す）
hardware/out/completion/*.jar
hardware/out/completion/pass*/
hardware/out/completion/*.kicad_pcb
hardware/out/completion/*.kicad_pro
hardware/out/completion/*.kicad_prl
hardware/out/completion/*.json
hardware/out/completion/original-before-routing/
hardware/out/*.json
